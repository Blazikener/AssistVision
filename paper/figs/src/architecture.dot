digraph G {
  rankdir=LR; splines=ortho; nodesep=0.35; ranksep=0.5;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#F4F6F8", color="#5B6770"];
  edge [fontname="Helvetica", fontsize=8, color="#5B6770"];
  subgraph cluster_rig { label="Capture rig (ESP32-S3)"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#2B6CB0";
    cam [label="OV2640\nUXGA JPEG"]; lc [label="Load cell\n+ HX711"]; tt [label="28BYJ-48\nturntable"]; mk [label="ArUco mat\n(50 mm)"];
    fw [label="Firmware\nHTTP API", fillcolor="#E3EEFA"];
    cam -> fw; lc -> fw; fw -> tt; }
  subgraph cluster_host { label="Host (laptop / server)"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#2F855A";
    cli [label="rig_client.py\nscan.json"]; sfm [label="SfM\n(COLMAP)"]; scale [label="Metric scale\nmarker triangulation"];
    mvs [label="Dense MVS\n(OpenMVS)"]; mono [label="Mono depth\n(DA-V2 / Depth Pro ...)"]; anchor [label="Plane anchor\n(marker PnP)"];
    vol [label="Shared volume integral\n(height field over plane)", fillcolor="#E6F4EA"];
    mass [label="Volume → grams\n(density)"]; eval [label="Evaluation vs\nweighed mass", fillcolor="#FFF5E0"]; }
  fw -> cli [label="Wi-Fi"]; mk -> cam [style=dashed, arrowhead=none];
  cli -> sfm -> scale -> mvs -> vol; cli -> mono -> anchor -> vol; vol -> mass -> eval;
  cli -> eval [label="grams (GT)", style=dashed];
}
