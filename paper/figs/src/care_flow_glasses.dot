digraph G {
  rankdir=LR; nodesep=0.25; ranksep=0.35;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#F4F6F8", color="#5B6770"];
  edge [fontname="Helvetica", fontsize=8, color="#5B6770"];
  subgraph cluster_meal { label="At the table (carer wears the glasses)"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#2B6CB0";
    serve [label="Serve\npress + head sweep\n(V_served)"]; eat [label="Older adult\neats"]; clear [label="Clear\npress + head sweep\n(V_cleared)"];
    serve -> eat -> clear; }
  subgraph cluster_host { label="Host + app"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#2F855A";
    intake [label="Intake\n% eaten = 1 - V_cleared / V_served", fillcolor="#E6F4EA"];
    log [label="Meal log\n+ 14-day trend"]; rule [label="Alert rule\nk low meals in a row\n(set by clinician)"]; }
  fam [label="Family\nalert + daily view", fillcolor="#FFF5E0"]; doc [label="Doctor / dietitian\nweekly report", fillcolor="#FFF5E0"];
  clear -> intake; intake -> log -> rule; rule -> fam; log -> doc; doc -> rule [style=dashed, label="sets threshold"];
}
