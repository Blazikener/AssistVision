# Raw captures are large and regenerable from the physical rig.
# Keep manifests and ground-truth logs in data/ under version control instead.
captures/
*.png
*.jpg
*.jpeg
!data/aruco_sheet.png

# Never commit personal documents (CVs, scanned IDs) to a public repo.
# Papers you cite belong in paper/refs/, which is exempted below.
*.pdf
!paper/refs/*.pdf
!paper/figs/*.pdf
!paper/main.pdf

# COLMAP working directories
sparse/
dense/
*.db
*.ply
*.bin

__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
NOTES.md
STUDY.md

# Rendered synthetic scenes are regenerable (experiments/synth/make_suite.py);
# keep only their specs and ground truth.
data/synth/**/*.exr
data/synth/**/*.log
results/synth/runs/
results/**/run.log

# LaTeX build products (main.pdf is kept)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
results/synth/*.log
data/synth/watch_main.sh
